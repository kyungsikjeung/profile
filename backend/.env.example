APP_NAME=Portfolio3D
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/portfolio3d
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MESHY_API_KEY=your-meshy-api-key
TRIPO_API_KEY=your-tripo-api-key
CONVERSION_PROVIDER=auto # auto | meshy | tripo | mock

AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET=portfolio3d-assets

SENTRY_DSN=your-sentry-dsn

# 배포 시 콤마 구분으로 덮어쓰기:
# CORS_ORIGINS=https://p3d-frontend.vercel.app
